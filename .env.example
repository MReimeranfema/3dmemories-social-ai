# ============================================================
# 3D Memories Social AI — Umgebungsvariablen
# cp .env.example .env  →  Werte eintragen  →  niemals committen
# ============================================================

# Datenbank
DATABASE_URL=postgresql://social_ai:secret@localhost:5432/social_ai_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_DM_USER_ID=UXXXXXXXXX
SLACK_CHANNEL_CONTROL=#3dm-control
SLACK_CHANNEL_ERRORS=#3dm-errors
AUTHORIZED_SLACK_USERS=UXXXXXXXXX

# Google
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/credentials.json
GOOGLE_DRIVE_FOLDER_ID=...
GOOGLE_SHEETS_SPREADSHEET_ID=...
GOOGLE_SHEETS_TAB_JOBS=CONTENT-JOBS

# App
APP_ENV=development
DEBUG=true
